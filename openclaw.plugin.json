{
  "id": "dataops-guardian",
  "name": "DataOps Guardian",
  "description": "Persists incident workflow state and enforces DataOps investigation policy.",
  "contracts": {
    "tools": [
      "guardian_inspect_metric_snapshot",
      "guardian_propose_remediation",
      "guardian_query_prometheus"
    ]
  },
  "toolMetadata": {
    "guardian_inspect_metric_snapshot": {
      "optional": false
    },
    "guardian_propose_remediation": {
      "optional": false
    },
    "guardian_query_prometheus": {
      "optional": false
    }
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "prometheusBaseUrl": {
        "type": "string",
        "description": "Administrator-configured Prometheus base URL."
      },
      "prometheusTimeoutMs": {
        "type": "integer",
        "minimum": 200,
        "maximum": 30000,
        "default": 5000
      }
    }
  }
}
