{
  "id": "dataops-guardian",
  "name": "DataOps Guardian",
  "description": "Evidence-gated incident investigation and allowlisted Kubernetes Deployment rollback with dual recovery verification.",
  "contracts": {
    "tools": [
      "guardian_inspect_metric_snapshot",
      "guardian_propose_remediation",
      "guardian_query_prometheus",
      "guardian_rollback_deployment",
      "guardian_verify_deployment_recovery"
    ]
  },
  "toolMetadata": {
    "guardian_inspect_metric_snapshot": {
      "optional": false
    },
    "guardian_propose_remediation": {
      "optional": false
    },
    "guardian_query_prometheus": {
      "optional": false
    },
    "guardian_rollback_deployment": {
      "optional": false
    },
    "guardian_verify_deployment_recovery": {
      "optional": false
    }
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "prometheusBaseUrl": {
        "type": "string",
        "description": "Administrator-configured Prometheus base URL."
      },
      "prometheusTimeoutMs": {
        "type": "integer",
        "minimum": 200,
        "maximum": 30000,
        "default": 5000
      },
      "enforceRequireToolsOnAgentRuns": {
        "type": "boolean",
        "default": false,
        "description": "Legacy compatibility switch. true maps to requireToolsGateMode=all_agent_runs."
      },
      "requireToolsGateMode": {
        "type": "string",
        "enum": [
          "disabled",
          "on_guardian_tool",
          "all_agent_runs"
        ],
        "default": "on_guardian_tool",
        "description": "Control require_tools enforcement. disabled is intended for controlled A/B evaluation; durable incident and approval policy remains active."
      },
      "lobsterToolPolicyMode": {
        "type": "string",
        "enum": [
          "incident_workflow_only",
          "disabled"
        ],
        "default": "incident_workflow_only",
        "description": "Block run-identified Agent calls and restrict authenticated non-Agent Lobster RPC to the immutable incident workflow. disabled is for controlled local fixtures only."
      },
      "kubernetes": {
        "type": "object",
        "additionalProperties": false,
        "description": "Administrator-only Kubernetes Deployment rollback configuration. Never model- or caller-supplied.",
        "properties": {
          "clusterId": {
            "type": "string",
            "description": "Identifier that must match the scoped kubeconfig's current-context name."
          },
          "kubeconfigPath": {
            "type": "string",
            "description": "Absolute path to the disposable, namespace-scoped kubeconfig used for rollback."
          },
          "allowlist": {
            "type": "array",
            "description": "Exact namespace/deployment pairs guardian_rollback_deployment is permitted to mutate.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespace", "deployment"],
              "properties": {
                "namespace": { "type": "string" },
                "deployment": { "type": "string" },
                "recovery": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "prometheusQuery",
                    "comparator",
                    "threshold",
                    "maxSampleAgeSeconds"
                  ],
                  "properties": {
                    "prometheusQuery": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "description": "Administrator-owned PromQL used for post-rollback recovery verification."
                    },
                    "comparator": {
                      "type": "string",
                      "enum": ["gte", "lte"]
                    },
                    "threshold": { "type": "number" },
                    "maxSampleAgeSeconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 86400
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
